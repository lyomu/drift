NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://drift:drift@localhost:5434/drift_tennis
REDIS_URL=redis://localhost:6379

# Use a generated value of at least 32 random bytes outside local development.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PLATFORM_ADMIN_JWT_TTL=2h
PLATFORM_ADMIN_WEB_URL=http://localhost:3002

# Comma-separated origins only. Production startup fails when this is absent,
# contains a wildcard, contains a path, or contains a non-HTTPS origin.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
