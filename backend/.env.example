NODE_ENV=development
PORT=3009

DATABASE_URL=postgresql://drift:drift@localhost:5434/drift_tennis
REDIS_URL=redis://localhost:6379

# Use a generated value of at least 32 random bytes outside local development.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PLATFORM_ADMIN_JWT_TTL=2h
PLATFORM_ADMIN_WEB_URL=http://localhost:3011
# Base URL of the club-admin console — used to build the club-setup magic link
# sent (logged, in dev) when a club creation request is approved.
CLUB_ADMIN_URL=http://localhost:3010

# Comma-separated origins only. Production startup fails when this is absent,
# contains a wildcard, contains a path, or contains a non-HTTPS origin.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3010,http://localhost:3011

# News RSS ingestion (SSRF policy — see src/news/feed-fetch.ts).
# Optional comma-separated host allowlist. When set, a news source's feedUrl
# host must match exactly or both the admin save and the fetch are rejected.
# NEWS_FEED_ALLOWED_HOSTS=feeds.bbci.co.uk,www.atptour.com
# Allow http:// feed URLs. Non-production only; ignored when NODE_ENV=production.
# NEWS_FEED_ALLOW_INSECURE=false

# Transactional email (MailModule). Leave SMTP_HOST unset to keep the
# pre-mailer behaviour: dev console codes, `PENDING_PROVIDER` in production.
# Port 465 uses implicit TLS; port 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Drift Tennis <no-reply@einsbrand.com>

# Push notifications (PushModule, Phase 6). The whole service-account JSON on
# one line. Leave unset and push is disabled: every send is a silent no-op and
# the app behaves exactly as it does without this feature.
# Firebase console -> Project settings -> Service accounts -> Generate key.
FIREBASE_SERVICE_ACCOUNT=

# Social sign-in (Phase 4). Each is the *audience* an identity token is checked
# against — a token minted for someone else's client is rejected. Leave unset
# and that provider's routes answer 503 rather than trusting anything.
# Android, iOS and Web each get their own Google client ID; list them all, and
# note google_sign_in only returns an idToken when a Web client ID exists.
GOOGLE_OAUTH_CLIENT_IDS=
# Apple: the Services ID (web/Android) and the app's bundle ID (iOS).
APPLE_SERVICES_ID=
APPLE_BUNDLE_ID=

# Club billing through IntaSend (tracker 7.1). Clubs pay here, in the web
# console; mobile app users are free at launch and any later mobile
# subscription has to go through Play/App Store billing instead.
#
# Leave INTASEND_SECRET_KEY unset and billing runs on the sandbox provider, so
# a dev machine and CI exercise the whole surface with no credentials. Set it
# and the hosted provider takes over.
#
# The API host is derived from the key: ISSecretKey_test_… targets
# sandbox.intasend.com, ISSecretKey_live_… targets payment.intasend.com. Never
# put a live key in a non-production environment — the app refuses to boot with
# one under NODE_ENV=test, because a suite would move real money.
INTASEND_SECRET_KEY=
# The value entered alongside the endpoint URL in the IntaSend dashboard's
# webhook settings. It arrives in the POST body and is the only thing proving a
# confirmation is genuine, so production refuses to start without it whenever a
# secret key is present.
INTASEND_WEBHOOK_CHALLENGE=
# Optional. Only for a proxy; leave blank to let the key decide the host.
INTASEND_BASE_URL=
